-		if (original == NULL || (uintptr_t)original != r->expected + slide) {
+		bool verified_20h392 = r->replacement == (IMP)prewarm_portrait_filter &&
+		    portrait_prewarm_20h392(method, original);
+		if (original == NULL || ((uintptr_t)original != r->expected + slide && !verified_20h392)) {
 			say("redwood: %c[%s %s]: found %#lx, expected %#lx; left alone\n", r->instance ? '-' : '+', r->class_name,
 			    r->selector,
 			    original ? (uintptr_t)original - slide : 0, r->expected);
@@ -633,6 +683,9 @@ image_added(__unused const struct mach_header *header, __unused intptr_t image_slide)
 			*r->original = original;
 		}
 		method_setImplementation(method, r->replacement);
+		if (verified_20h392) {
